COPY (
        WITH existing_candidates AS (
            SELECT master_id, customer_name, email, phone, city, country, source_system, updated_date, 0 AS priority, 0::BIGINT AS customer_id FROM reference_clean
            UNION ALL
            SELECT matched_master_id AS master_id, customer_name, email, phone, city, country, source_system, updated_date, 1 AS priority, customer_id FROM read_parquet('C:/Users/SUBHRADEEP/duck-load-test/batches/100000_rows/data/silver/matched.parquet')
        ), existing_winners AS (
            SELECT master_id, customer_name, email, phone, city, country, source_system, updated_date FROM existing_candidates
            QUALIFY row_number() OVER (
                PARTITION BY master_id ORDER BY updated_date DESC NULLS LAST, priority, customer_id
            ) = 1
        ), new_winners AS (
            SELECT * FROM read_parquet('C:/Users/SUBHRADEEP/duck-load-test/batches/100000_rows/data/silver/unmatched.parquet')
            QUALIFY row_number() OVER (
                PARTITION BY email ORDER BY updated_date DESC NULLS LAST, customer_id
            ) = 1
        ), new_masters AS (
            SELECT (SELECT coalesce(max(master_id), 0) FROM reference_clean)
                   + row_number() OVER (ORDER BY customer_id) AS master_id, customer_name, email, phone, city, country, source_system, updated_date
            FROM new_winners
        )
        SELECT * FROM existing_winners UNION ALL SELECT * FROM new_masters
    ) TO 'C:/Users/SUBHRADEEP/duck-load-test/batches/100000_rows/data/gold/customers.partial.parquet' (FORMAT PARQUET, COMPRESSION SNAPPY)
